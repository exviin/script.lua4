local flyVelocity
local flyGyro

local function stopFly()
    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end
end

RunService.Heartbeat:Connect(function(dt)
    local char = getCharacter()
    local hum = getHumanoid()
    local root = getRoot()

    if not char or not hum or not root then
        stopFly()
        return
    end

    -- Speed
    if speedOn then
        hum.WalkSpeed = walkSpeed
    end

    -- Noclip: احفظ حالة التصادم الأصلية
    if noclipOn then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                if savedCollision[obj] == nil then
                    savedCollision[obj] = obj.CanCollide
                end
                obj.CanCollide = false
            end
        end
    end

    -- Fly
    if flyOn then
        if not flyVelocity or not flyVelocity.Parent then
            flyVelocity = Instance.new("BodyVelocity")
            flyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyVelocity.Velocity = Vector3.zero
            flyVelocity.Parent = root

            flyGyro = Instance.new("BodyGyro")
            flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            flyGyro.P = 10000
            flyGyro.CFrame = root.CFrame
            flyGyro.Parent = root
        end

        local camera = workspace.CurrentCamera
        local movement = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            movement += camera.CFrame.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            movement -= camera.CFrame.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            movement += camera.CFrame.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            movement -= camera.CFrame.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            movement += Vector3.yAxis
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            movement -= Vector3.yAxis
        end

        flyVelocity.Velocity = movement.Magnitude > 0
            and movement.Unit * flySpeed
            or Vector3.zero

        flyGyro.CFrame = camera.CFrame
    else
        stopFly()
    end

    -- Follow / Spin
    if autoOn then
        local target = nearestPlayer()
        local targetRoot = target
            and target.Character
            and target.Character:FindFirstChild("HumanoidRootPart")

        if targetRoot then
            targetLabel.Text = "TARGET: " .. target.Name
            targetLabel.TextColor3 = C.accent

            local offset

            if spinOn then
                angle += math.rad(spinSpeed * 20) * dt

                offset = Vector3.new(
                    math.cos(angle) * followDistance,
                    0,
                    math.sin(angle) * followDistance
                )
            else
                offset = Vector3.new(0, 0, followDistance)
            end

            local destination = targetRoot.Position + offset

            root.CFrame = CFrame.lookAt(
                destination,
                targetRoot.Position
            )
        else
            targetLabel.Text = "TARGET: No target"
            targetLabel.TextColor3 = C.muted
        end
    else
        targetLabel.Text = "TARGET: No target"
        targetLabel.TextColor3 = C.muted
    end
end)

player.CharacterAdded:Connect(function()
    stopFly()
    task.wait(1)

    if speedOn then
        local hum = getHumanoid()
        if hum then
            savedWalkSpeed = hum.WalkSpeed
            hum.WalkSpeed = walkSpeed
        end
    end

    if invisibleOn then
        setInvisible(true)
    end

    if not noclipOn then
        savedCollision = {}
    end
end)

