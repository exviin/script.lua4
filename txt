section(skinsPage, "LOCAL APPEARANCE")

local headStorage = {}
local legStorage = {}

local function setParts(parts, hide, storage)
    local char = getCharacter()
    if not char then return end

    if hide then
        storage.parts = {}

        for _, partName in ipairs(parts) do
            local part = char:FindFirstChild(partName, true)

            if part and part:IsA("BasePart") then
                storage.parts[part] = part.Transparency
                part.Transparency = 1

                for _, child in ipairs(part:GetDescendants()) do
                    if child:IsA("Decal") then
                        storage.parts[child] = child.Transparency
                        child.Transparency = 1
                    end
                end
            end
        end
    else
        for obj, oldValue in pairs(storage.parts or {}) do
            if obj and obj.Parent then
                obj.Transparency = oldValue
            end
        end
        storage.parts = {}
    end
end

toggle(skinsPage, "HEADLESS - HIDE HEAD", function(on)
    setParts({"Head"}, on, headStorage)
end)

