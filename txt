local function slider(parent, title, minValue, maxValue, defaultValue, callback)
    local frame = create("Frame", {
        Size = UDim2.new(1, -4, 0, 63),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0
    }, parent)
    round(frame, 8)

    local label = create("TextLabel", {
        Position = UDim2.fromOffset(11, 5),
        Size = UDim2.new(1, -22, 0, 20),
        BackgroundTransparency = 1,
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, frame)

    local bar = create("Frame", {
        Position = UDim2.fromOffset(11, 37),
        Size = UDim2.new(1, -22, 0, 7),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0
    }, frame)
    round(bar, 5)

    local fill = create("Frame", {
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0
    }, bar)
    round(fill, 5)

    local value = defaultValue

    local function setValue(v)
        value = math.clamp(math.floor(v + 0.5), minValue, maxValue)
        label.Text = title .. "  [" .. value .. "]"
        fill.Size = UDim2.new(
            (value - minValue) / (maxValue - minValue), 0, 1, 0
        )
        callback(value)
    end

    local function update(input)
        local width = math.max(bar.AbsoluteSize.X, 1)
        local pct = math.clamp(
            (input.Position.X - bar.AbsolutePosition.X) / width, 0, 1
        )
        setValue(minValue + pct * (maxValue - minValue))
    end

    setValue(defaultValue)

    local sliding = false

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            update(input)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if sliding and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    return function()
        return value
    end
end

